# Copy to ~/.secrets and fill in your keys:
#   cp .secrets.example ~/.secrets && chmod 600 ~/.secrets
#
# Get keys at:
#   OpenRouter:  https://openrouter.ai/keys
#   NVIDIA NIM:  https://build.nvidia.com/explore/discover
#   OpenCode Go: https://opencode.ai/account

export OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export OPENCODE_GO_API_KEY=oc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
